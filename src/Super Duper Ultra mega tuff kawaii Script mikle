    if ($fehler.Count) {
        Write-Host "ACHTUNG - PowerShell meldet $($fehler.Count) Syntaxfehler:" -ForegroundColor Red
        $fehler | Select-Object -First 5 | ForEach-Object { Write-Host "  Zeile $($_.Extent.StartLineNumber): $($_.Message)" -ForegroundColor Red }
    } else {
        Write-Host "OK - Skript liegt unter $ziel (Pruefsumme stimmt, keine Syntaxfehler)" -ForegroundColor Green
    }
}
